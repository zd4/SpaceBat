    "frameParser": "\nconst myArray = [\"00\", \"00\", \"00\",\"g1\",\"g2\",\"g3\"];\nfunction parse(frame, separator) {\n\n   let pairs = frame.match(/.{1,2}/g) || [];\n\n   if(pairs[5]==\"ff\"){\t//Zoom-command\n\tif(pairs[4][0]==\"2\") myArray[2]=pairs[4][1];\n\telse if(pairs[4][0]==\"3\") myArray[2]=\"-\"+pairs[4][1];\n\telse myArray[2]=\"0\";\n\tmyArray[5]= (parseInt(myArray[2],10)*10).toString();\n\t}\n  else{\n\tif(pairs[6]==\"01\") myArray[0]=pairs[4];\n\telse if(pairs[6]==\"02\") myArray[0]=\"-\"+pairs[4];\t\n\telse myArray[0]=\"00\";\n\tif(pairs[7]==\"01\") myArray[1]=pairs[5];\n\telse if (pairs[7]==\"02\") myArray[1]=\"-\"+pairs[5];\n\telse myArray[1]=\"00\";\n\t//myArray[3]= (parseInt(myArray[0],10)*8).toString();\t\n\t//myArray[4]= (parseInt(myArray[1],10)*10).toString();\n\t\n\t// the following normalization is for the acc-visualization only.\n\t// note that the current implementation does not normalize P/T towards the camera\n\tpan=parseInt(myArray[0],10);\n\ttilt=parseInt(myArray[1],10);\n\tmagnitude=Math.sqrt(pan * pan + tilt * tilt);\n\tif (magnitude === 0) {\n\t\tmyArray[3]=\"0\";\n\t\tmyArray[4]=\"0\";\n\t}\n\telse{\n\t\tmyArray[3]=(pan*150/magnitude).toString();\n\t\tmyArray[4]=(tilt*150/magnitude).toString();}\n\t}\n  \n    return myArray;\n}\n",
